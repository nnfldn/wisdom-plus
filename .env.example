APP_NAME="WisDom+"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wisdom_plus
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Supabase Storage S3 credentials (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public/sheep-images/
SUPABASE_KEY=
SUPABASE_SECRET=
SUPABASE_REGION=ap-southeast-1
SUPABASE_BUCKET=sheep-images

# External chatbot proxy (server only; never use VITE_ for secrets)
CHATBOT_API_URL=https://chatbot-wisma-domba-farm.vercel.app/api/ask
CHATBOT_API_KEY=
CHATBOT_TIMEOUT=30
CHATBOT_LOG_TRANSCRIPTS=false

# Optional Cloud Run scheduler endpoint bearer token
GCP_SCHEDULER_TOKEN=

# Initial admin accounts; use strong passwords and remove after seeding
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
